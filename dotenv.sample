# docker compose
# WEB_ENV: dev|prod|staging
WEB_ENV=dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=naturedb
PORTAL_HOST=www.naturedb.org
SECRET_KEY=mykey
SERVICE_KEY=1234

FRONTEND_SEARCH_VERSION=foo
BACKEND_SEARCH_VERSION=foo
# admin clients on other subdomains (comma-separated origins) and the cookie domain they share
CORS_ALLOWED_ORIGINS=
JWT_COOKIE_DOMAIN=
